# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (use the pooled connection for serverless)
# Format: postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Better Auth — generate a 32+ char secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Defaults to http://localhost:3000 in dev; set explicitly in production.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Vercel Blob — read/write token for PDF storage
# Auto-provided on Vercel deployments; for local dev run `vercel env pull .env.local` to fetch it.
BLOB_READ_WRITE_TOKEN=

# Private Codex-to-app bridge. Create a revocable key at /settings/agent-access.
# These values are read only by the local `pnpm agent` client.
AGENT_API_BASE_URL=http://localhost:3000
AGENT_API_TOKEN=

# Skip t3-env validation during builds when env vars aren't yet wired (e.g. CI).
# SKIP_ENV_VALIDATION=true
